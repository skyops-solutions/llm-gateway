{
  "uid": "llm-gateway",
  "title": "LLM Gateway",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Monthly budget used, by client",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_budget_used_ratio",
          "legendFormat": "{{tenant}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Calculated cost in the last hour, USD, by client",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (increase(gateway_cost_usd_total[1h]))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Requests per second, by result",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(gateway_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50 / p95 (end to end)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gateway_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time added by the gateway, p95",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_overhead_seconds_bucket[1m])))",
          "legendFormat": "p95 overhead"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Fallbacks and upstream errors",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from_provider, to_provider) (increase(gateway_fallback_total[1m]))",
          "legendFormat": "fallback {{from_provider}} -> {{to_provider}}"
        },
        {
          "refId": "B",
          "expr": "sum by (provider, reason) (increase(gateway_upstream_errors_total[1m]))",
          "legendFormat": "error {{provider}} {{reason}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache hit rate",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_cache_total{result=\"hit\"}[15m])) / clamp_min(sum(rate(gateway_cache_total[15m])), 1e-9)",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens per minute, by client",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant, direction) (rate(gateway_tokens_total[1m])) * 60",
          "legendFormat": "{{tenant}} {{direction}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Blocked requests (rate limit, budget, PII masked)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant) (increase(gateway_rate_limited_total[1m]))",
          "legendFormat": "rate limited {{tenant}}"
        },
        {
          "refId": "B",
          "expr": "sum by (tenant) (increase(gateway_budget_blocked_total[1m]))",
          "legendFormat": "budget stop {{tenant}}"
        },
        {
          "refId": "C",
          "expr": "sum by (tenant, kind) (increase(gateway_pii_masked_total[1m]))",
          "legendFormat": "PII masked {{tenant}} {{kind}}"
        }
      ]
    }
  ],
  "tags": [
    "llm",
    "cost"
  ]
}